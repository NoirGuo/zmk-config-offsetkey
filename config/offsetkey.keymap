#define BASE 0
#define LOWER 1
#define MOUSE_KEYS 2
#define MOUSE_TP 3
#define MOUSE_TP_SET 4

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };
    };

    combos {
        compatible = "zmk,combos";

        flash {
            bindings = <&bootloader>;
            key-positions = <0 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp ESC       &kp N1          &kp N2           &kp N3          &kp N4     &kp N5     &kp N6      &kp N7     &kp N8     &kp N9         &kp N0   &kp MINUS  &kp EQUAL  &kp BSPC      &kp F5                 &kp NUMBER_6
&kp TAB       &kp Q           &kp W            &kp E           &kp R      &kp T                  &kp Y      &kp U      &kp I          &kp O    &kp P      &kp LBKT   &kp RBKT      &kp BSLH    &kp PG_UP  &kp T
&kp CAPS      &kp A           &kp S            &kp D           &kp F      &kp G                  &kp H      &kp J      &kp K          &kp L    &kp SEMI   &kp APOS   &kp ENTER     &kp PG_DN              &kp G
&kp LSHFT     &kp Z           &kp X            &kp C           &kp V      &kp B                  &kp N      &kp M      &kp COMMA      &kp DOT  &kp FSLH   &kp RSHFT  &kp UP_ARROW  &kp DELETE             &kp B
&kp LCTRL     &mo 1           &kp LGUI         &kp LALT                   &kp SPACE                         &kp SPACE  &kp RIGHT_ALT  &mo 2    &kp RCTRL  &kp LEFT   &kp DOWN      &kp RIGHT              &kp SPACE
&mmv MOVE_UP  &mmv MOVE_LEFT  &mmv MOVE_RIGHT  &mmv MOVE_DOWN  &kp ENTER  &kp SPACE              &mkp LCLK  &mkp MCLK  &mkp RCLK      &none
            >;

            label = "layer0";
            sensor-bindings = <&rsr_vol>;
        };

        layer_1 {
            bindings = <
&kp GRAVE  &kp F1    &kp F2     &kp F3    &kp F4      &kp F5  &kp F6      &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans             &trans
&trans     &trans    &trans     &trans    &trans      &trans              &trans  &trans  &trans  &trans   &trans   &trans   &trans  &trans   &kp HOME  &trans
&trans     &trans    &trans     &trans    &trans      &trans              &trans  &trans  &trans  &trans   &trans   &trans   &trans  &kp END            &trans
&trans     &trans    &trans     &trans    &trans      &trans              &none   &none   &trans  &trans   &trans   &trans   &trans  &kp INS            &trans
&trans     &trans    &trans     &trans                &trans                      &trans  &trans  &trans   &trans   &trans   &trans  &trans             &trans
&kp UP     &kp LEFT  &kp RIGHT  &kp DOWN  &kp C_MUTE  &trans              &trans  &trans  &trans  &trans
            >;

            label = "layer1";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&studio_unlock  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans           &trans           &trans           &trans           &trans           &trans  &trans  &trans                   &trans
&trans          &bt BT_CLR    &out OUT_TOG  &trans        &trans        &trans                    &trans           &trans           &trans           &trans           &trans           &trans  &trans  &trans           &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans                    &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF  &trans  &trans  &rgb_ug RGB_ON           &trans
&trans          &trans        &trans        &trans        &trans        &trans                    &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR  &trans  &trans  &rgb_ug RGB_OFF          &trans
&trans          &trans        &trans        &trans                      &trans                                     &trans           &trans           &trans           &trans           &trans  &trans  &trans                   &trans
&trans          &trans        &trans        &trans        &trans        &trans                    &trans           &trans           &trans           &trans
            >;

            label = "layer2";
            sensor-bindings = <&rsr_vol>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans
&trans  &trans  &trans  &trans          &trans                      &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans
            >;

            label = "layer3";
            sensor-bindings = <&rsr_vol>;
        };
    };
};
