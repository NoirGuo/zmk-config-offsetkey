// 引用的库文件，<>的是官方库和第三方库的硬件配置、定义之类，""的是本仓库内的基础硬件配置
#include <dt-bindings/zmk/matrix_transform.h>
#include  "offsetkey_physical_layout.dtsi"
#include <dt-bindings/led/led.h>

/ {
     chosen {
        // 绑定物理布局定义
        zmk,physical-layout = &offsetkey_physical_layout;
        // 使用OLED屏幕
        zephyr,display = &oled;
        // 使用按键扫描定义kscan0
        zmk,kscan = &kscan0;
        // 使用键盘背光
        zmk,backlight = &backlight;
    };

// === 键盘背光设置 ===
// 键盘背光节点
backlight: pwmleds {
    // 使用pwm-leds驱动
    compatible = "pwm-leds";
    // 0和2被注释禁用，只启用1
    // 周期 1ms、正常极性
   // pwm_led_0: pwm_led_0 {
   //     pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
  //  };
    pwm_led_1: pwm_led_1 {
        pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
    };
  //  pwm_led_2: pwm_led_2 {
   //     pwms = <&pwm0 2 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
  //  };
};

    // 左旋钮编码器节点
	left_encoder: encoder_left {
        // 使用ec11驱动，基本上各种编码器都用这个驱动就行，包括但不限于普通旋钮编码器，松下滚轮编码器，鼠标滚轮编码器等
		compatible = "alps,ec11";
        // 标签定义
		label = "LEFT_ENCODER";
        // 脉冲数和定位数，是旋钮的基础参数，具体数值需要看自己买的旋转编码器的规格书，如果没有规格书就找卖家问清楚
        // 每旋转一格AB相边沿采样数，=脉冲数*4/定位数
		resolution = <4>;
        // 定位数，旋转一圈有40格
        steps = <40>;
        // AB相引脚定义
        a-gpios = <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
	    b-gpios = <&gpio0 25 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        // 默认不启用，在对应的overlay文件中启用
		status = "disabled";
	};

    //传感器节点
    sensors {
        // 使用sensors驱动
		compatible = "zmk,keymap-sensors";
        // 每圈触发按键动作数，现在代码里一圈有40格，如果触发20次动作，意思就是每2格触发一次动作，有一点慢，但是我个人习惯是一次拧两格，所以就还好
        triggers-per-rotation = <20>;
		sensors = <&left_encoder>;
	};

    // 矩阵定义
    default_transform: keymap_transform_0 {
        // 使用矩阵转换
		compatible = "zmk,matrix-transform";
        // 总列数和总行数
        columns = <19>;
        rows = <6>;
        // 每个按键所在的行/列。前5行是标准矩阵变换的按键，第6行是direct pin的按键
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)            RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,18)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                    RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15) RC(1,16) RC(1,17) RC(1,18)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                    RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15) RC(2,16) RC(2,18)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                    RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15) RC(3,16) RC(3,18)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3)         RC(4,5)                                     RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15) RC(4,16) RC(4,17) RC(4,18)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5)                    RC(5,9) RC(5,10) RC(5,11) RC(5,12)
        >;
    };
};    

// i2c节点
&i2c0 {
	status = "okay";
	compatible = "nordic,nrf-twi";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    // offsetkey默认屏幕模块使用的是0.91英寸OLED屏幕，ssd1306驱动，如果是别的屏幕，比如1.3英寸屏幕用的是sh1106驱动，需要把下面两行修改成对应的型号
    oled: ssd1306@3c {
        // 引号内的屏幕型号详见Zephyr相关页面https://docs.zephyrproject.org/4.1.0/build/dts/api/bindings.html
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        // 屏幕分辨率，宽128，高32
        width = <128>;
        height = <32>;
        // 下面四行一般不修改
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        // 多路复用比率，0到31，共32行
        multiplex-ratio = <31>;
        // 下面四行调整画面用
        // 水平翻转
        segment-remap;
        // 垂直翻转
        com-invdir;
        // 画面顺序扫描
        com-sequential;
        // 像素反转
        inversion-on;
        // 这个不修改
        prechargep = <0x22>;
    };
};

// 引脚控制配置，这一段是backlight键盘背光的引脚配置，一般人用不到，可删
&pinctrl {
    // Other Pinctrl definitions go here
    pwm0_default: pwm0_default {
        group1 {
            // 括号里面的0, 27是引脚编号，前面的1是PWM_OUT1
            psels = //<NRF_PSEL(PWM_OUT0, 1, 3)>, 
                    <NRF_PSEL(PWM_OUT1, 0, 27)>; // LED 1
                   // <NRF_PSEL(PWM_OUT2, 1, 2)>; LED 2
        };
    };
    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = //<NRF_PSEL(PWM_OUT0, 1, 3)>, 
                    <NRF_PSEL(PWM_OUT1, 0, 27)>; // LED 1
                                                                 // <NRF_PSEL(PWM_OUT2, 1, 2)>;
            low-power-enable;
        };
    };
};










